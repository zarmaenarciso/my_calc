rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Superuser check via Firebase Custom Claim OR server/console-managed `superusers/{uid}` doc
    function isSuperUser() {
      return isSignedIn() && (
        request.auth.token.superUser == true
        || exists(/databases/$(database)/documents/superusers/$(request.auth.uid))
      );
    }

    // Read-only superuser registry (writable only via Firebase Console or Admin SDK)
    match /superusers/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperUser());
      allow create, update, delete: if false;
    }

    // User profiles: superusers or strict per-user ownership
    match /profiles/{userId} {
      allow read, delete: if isSuperUser() || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if isSuperUser() || (
        isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'username', 'createdAt', 'updatedAt'])
      );
    }

    // Per-user bank items
    match /users/{userId}/banks/{bankId} {
      allow read, delete: if isSuperUser() || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if isSuperUser() || (
        isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'createdAt', 'updatedAt'])
      );
    }

    // Per-user collection of people
    match /users/{userId}/people/{personId} {
      allow read, delete: if isSuperUser() || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if isSuperUser() || (
        isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'notes', 'createdAt', 'updatedAt'])
      );

      // Nested records belonging to a specific person
      match /records/{recordId} {
        allow read, delete: if isSuperUser() || (isSignedIn() && request.auth.uid == userId);
        allow create, update: if isSuperUser() || (
          isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['item', 'type', 'date', 'amount', 'note', 'createdAt', 'updatedAt'])
        );
      }
    }

    // Superusers have full access across all documents; everyone else is denied by default
    match /{document=**} {
      allow read, write: if isSuperUser();
    }
  }
}
